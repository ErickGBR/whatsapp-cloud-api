# WhatsApp Cloud API — Environment Configuration
# ================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# REQUIRED: Access token from Meta App Dashboard
# WhatsApp > API Setup > Access Token
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# REQUIRED: Your WhatsApp phone number ID
# WhatsApp > API Setup > Phone number ID
PHONE_NUMBER_ID=your_phone_number_id_here

# REQUIRED: Webhook verification token (any secure string you choose)
# Must match the token you set in Meta App Dashboard webhook config
VERIFY_TOKEN=your_verify_token_here

# OPTIONAL: Graph API version (default: v22.0)
# API_VERSION=v22.0

# OPTIONAL: Server port (default: 3000)
# PORT=3000
