# Server
PORT=3000
NODE_ENV=development

# Database (SQLite)
DB_STORAGE=./data/database.sqlite

# Redis (for queues)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp Cloud API (primary production channel)
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# JWT Secret (for dashboard auth)
JWT_SECRET=your-jwt-secret-change-in-production

# Admin credentials (SEC-002) — REQUIRED in production (NODE_ENV=production).
# The app refuses to boot without them; the admin@example.com/admin123 default
# is development-only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# E2E stack: run-e2e.sh defaults to ADMIN_EMAIL=admin@example.com /
# ADMIN_PASSWORD=admin123; override via env if needed

# Dashboard
DASHBOARD_ORIGIN=http://localhost:5173
